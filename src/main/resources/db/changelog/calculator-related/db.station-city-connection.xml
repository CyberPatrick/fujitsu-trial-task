<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <changeSet id="0" author="Nikita">
        <createTable tableName="station_city_connection">
            <column name="station_name" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="city_name" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addPrimaryKey tableName="station_city_connection" columnNames="station_name, city_name"
                       constraintName="pk_station_city_connection__station_name_city_name"/>

        <insert tableName="station_city_connection">
