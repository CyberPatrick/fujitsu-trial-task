<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="0" author="Nikita">
        <createTable tableName="transport">
            <column name="id" type="serial" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_transport"/>
            </column>
            <column name="name" type="varchar(255)">
                <constraints unique="true" nullable="false"/>
            </column>
        </createTable>

        <insert tableName="transport">
            <column name="id" value="0"/>
            <column name="name" value="bike"/>
        </insert>
        <insert tableName="transport">
            <column name="id" value="1"/>
            <column name="name" value="scooter"/>
        </insert>
        <insert tableName="transport">
            <column name="id" value="2"/>
            <column name="name" value="car"/>
        </insert>
    </changeSet>
</databaseChangeLog>