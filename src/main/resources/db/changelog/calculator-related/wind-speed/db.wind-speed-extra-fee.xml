<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="0" author="Nikita">
        <createTable tableName="wind_speed_extra_fee">
            <column name="id" type="serial" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_wind_speed_extra_fee"/>
            </column>
            <column name="extra_fee" type="decimal(8, 2)"/>
<!--            if in this wind speed range courier can't work using specified transport types-->
            <column name="is_forbidden" type="boolean" defaultValueBoolean="false"/>
<!--            bounds works like this: [lower_bound, higher_bound)-->
            <column name="higher_bound" type="decimal(4, 1)"/>
            <column name="lower_bound" type="decimal(4, 1)"/>
            <column name="timestamp" type="timestamp with timezone" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addUniqueConstraint tableName="wind_speed_extra_fee" columnNames="timestamp, higher_bound, lower_bound"
                             constraintName="uk_wind_speed_extra_fee_timestamp_higher_bound_lower_bound"/>
        <sql>
            ALTER TABLE wind_speed_extra_fee
            ADD CONSTRAINT chk_wind_speed_extra_fee__extra_fee_not_null_if_is_forbidden_false
            CHECK (is_forbidden IS FALSE AND extra_fee IS NOT NULL OR is_forbidden IS TRUE)
        </sql>


        <insert tableName="wind_speed_extra_fee">
            <column name="id" value="0"/>
            <column name="extra_fee" value="0.5"/>
            <column name="is_forbidden" value="false"/>
            <column name="higher_bound" value="20.1"/>
            <column name="lower_bound" value="10"/>
        </insert>
        <insert tableName="wind_speed_extra_fee">
            <column name="id" value="1"/>
            <column name="extra_fee" value="null"/>
            <column name="is_forbidden" value="true"/>
            <column name="higher_bound" value="null"/>
            <column name="lower_bound" value="20.1"/>
        </insert>
    </changeSet>
</databaseChangeLog>